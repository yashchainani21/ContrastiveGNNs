 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Simple CPU Supervised Contrastive (SupCon) Prototype\n",
    "\n",
    "This notebook provides a minimal, single-CPU version of a supervised contrastive training loop\n",
    "to debug stability issues slowly. It loads NPZ fingerprints (fps, labels), trains a small encoder,\n",
    "and reports a validation AUPRC via a linear probe.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import average_precision_score\n",
    "import os\n",
    "\n",
    "torch.set_num_threads(1)  # keep it simple on CPU\n",
    "device = torch.device('cpu')\n",
    "print('Using device:', device)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuration\n",
    "TRAIN_NPZ = '../data/train/baseline_train_ecfp4.npz'\n",
    "VAL_NPZ   = '../data/val/baseline_val_ecfp4.npz'\n",
    "NORMALIZE = False\n",
    "BATCH_SIZE = 256\n",
    "EPOCHS = 5\n",
    "LR = 3e-4\n",
    "WEIGHT_DECAY = 1e-4\n",
    "TEMPERATURE = 0.1\n",
    "EMBED_DIM = 128\n",
    "PROJ_DIM = 64\n",
    "SEED = 42\n",
    "\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class NPZFingerprints(Dataset):\n",
    "    def __init__(self, npz_path: str, normalize: bool = False, mean=None, std=None):\n",
    "        z = np.load(npz_path, allow_pickle=False)\n",
    "        self.fps = z['fps']\n",
    "        self.labels = z['labels'].astype(np.int64)\n",
    "        self.N, self.D = self.fps.shape\n",
    "        self.normalize = normalize\n",
    "        if normalize:\n",
    "            if mean is not None and std is not None:\n",
    "                self.mean = mean.astype(np.float32)\n",
    "                self.std = std.astype(np.float32)\n",
    "            else:\n",
    "                arr = self.fps.astype(np.float32)\n",
    "                self.mean = arr.mean(axis=0)\n",
    "                self.std = arr.std(axis=0) + 1e-8\n",
    "        else:\n",
    "            self.mean = None; self.std = None\n",
    "    def __len__(self):\n",
    "        return self.N\n",
    "    def __getitem__(self, idx):\n",
    "        x = self.fps[idx].astype(np.float32)\n",
    "        if self.normalize:\n",
    "            x = (x - self.mean) / self.std\n",
    "        y = int(self.labels[idx])\n",
    "        return torch.from_numpy(x), torch.tensor(y, dtype=torch.long)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class TinyMLP(nn.Module):\n",
    "    def __init__(self, fp_dim: int, embed_dim: int = EMBED_DIM, proj_dim: int = PROJ_DIM):\n",
    "        super().__init__()\n",
    "        self.fc1 = nn.Linear(fp_dim, 256)\n",
    "        self.fc2 = nn.Linear(256, embed_dim)\n",
    "        self.proj = nn.Linear(embed_dim, proj_dim)\n",
    "    def forward(self, x):\n",
    "        h = F.relu(self.fc1(x))\n",
    "        g = F.normalize(self.fc2(h), dim=-1, eps=1e-6)\n",
    "        z = F.normalize(self.proj(g), dim=-1, eps=1e-6)\n",
    "        return g, z\n",
    "\n",
    "class SupConLoss(nn.Module):\n",
    "    def __init__(self, temperature: float = 0.1):\n",
    "        super().__init__()\n",
    "        self.tau = temperature\n",
    "    def forward(self, z, labels):\n",
    "        z = z.float()\n",
    "        B = z.size(0)\n",
    "        sim = (z @ z.t()) / float(self.tau)\n",
    "        eye = torch.eye(B, dtype=torch.bool, device=z.device)\n",
    "        labels = labels.view(-1, 1)\n",
    "        pos_mask = (labels == labels.t()) & (~eye)\n",
    "        sim = sim - sim.max(dim=1, keepdim=True).values\n",
    "        logits = sim.masked_fill(eye, float('-inf'))\n",
    "        denom = torch.logsumexp(logits, dim=1, keepdim=True)\n",
    "        log_prob = logits - denom\n",
    "        pos_counts = pos_mask.sum(1).clamp_min(1)\n",
    "        pos_log_prob = (pos_mask * log_prob).sum(1) / pos_counts\n",
    "        valid = (pos_mask.sum(1) > 0).float()\n",
    "        loss = -(pos_log_prob * valid).sum() / valid.sum().clamp_min(1)\n",
    "        return loss\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load datasets\n",
    "train_ds = NPZFingerprints(TRAIN_NPZ, normalize=NORMALIZE)\n",
    "if NORMALIZE:\n",
    "    mean, std = train_ds.mean, train_ds.std\n",
    "    val_ds = NPZFingerprints(VAL_NPZ, normalize=True, mean=mean, std=std)\n",
    "else:\n",
    "    val_ds = NPZFingerprints(VAL_NPZ, normalize=False)\n",
    "\n",
    "train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=0)\n",
    "val_loader   = DataLoader(val_ds,   batch_size=BATCH_SIZE, shuffle=False, num_workers=0)\n",
    "\n",
    "fp_dim = train_ds.D\n",
    "model = TinyMLP(fp_dim, EMBED_DIM, PROJ_DIM).to(device)\n",
    "criterion = SupConLoss(temperature=TEMPERATURE).to(device)\n",
    "optimizer = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n",
    "\n",
    "print(f'Train size: {len(train_ds)} | Val size: {len(val_ds)} | fp_dim={fp_dim}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Training loop (CPU)\n",
    "for epoch in range(1, EPOCHS+1):\n",
    "    model.train()\n",
    "    epoch_loss = 0.0\n",
    "    steps = 0\n",
    "    for xb, yb in train_loader:\n",
    "        xb = xb.to(device)\n",
    "        yb = yb.to(device)\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        g, z = model(xb)\n",
    "        loss = criterion(z, yb)\n",
    "        if not torch.isfinite(loss):\n",
    "            print(f'  Warning: non-finite loss (loss={loss.item():.4f}); skip step')\n",
    "            continue\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        epoch_loss += loss.item()\n",
    "        steps += 1\n",
    "    train_loss = epoch_loss / max(1, steps)\n",
    "\n",
    "    # Validation linear probe\n",
    "    model.eval()\n",
    "    all_g, all_y = [], []\n",
    "    with torch.no_grad():\n",
    "        for xb, yb in val_loader:\n",
    "            xb = xb.to(device)\n",
    "            g, z = model(xb)\n",
    "            all_g.append(g.cpu())\n",
    "            all_y.append(yb)\n",
    "    X = torch.cat(all_g, dim=0).numpy()\n",
    "    y = torch.cat(all_y, dim=0).numpy()\n",
    "    auprc = None\n",
    "    if X.shape[0] > 1 and len(np.unique(y)) > 1:\n",
    "        clf = LogisticRegression(max_iter=1000, class_weight='balanced')\n",
    "        clf.fit(X, y)\n",
    "        y_pred = clf.predict_proba(X)[:,1]\n",
    "        auprc = average_precision_score(y, y_pred)\n",
    "    print(f'[Epoch {epoch:03d}] train_supcon={train_loss:.4f} val_AUPRC={auprc if auprc is not None else "NA"}')\n"
   ]
  }
 ],
